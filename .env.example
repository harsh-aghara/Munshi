# Sarvam AI API key (required)
SARVAM_API_KEY=

# Access code for API gate (required)
ACCESS_CODE=

# Search provider for recipient lookup (tavily | serper | brave)
SEARCH_PROVIDER=tavily

# Search API key (required for recipient lookup)
SEARCH_API_KEY=

# Upstash Redis (optional; falls back to in-memory rate limiting in dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
